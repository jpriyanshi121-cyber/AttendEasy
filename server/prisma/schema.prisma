// AttendEasy data model — PostgreSQL version (Neon / Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String     @id @default(uuid())
  email                      String     @unique
  passwordHash               String
  name                       String
  remindersEnabled           Boolean    @default(false)
  lowAttendanceAlertsEnabled Boolean    @default(false)
  createdAt                  DateTime   @default(now())
  semesters                  Semester[]
  pushSubscriptions          PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Semester {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean    @default(true)
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  subjects   Subject[]
  slots      Slot[]
  records    AttendanceRecord[]

  @@index([userId])
}

model Subject {
  id                 String     @id @default(uuid())
  semesterId         String
  semester           Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  name               String
  code               String?
  color              String     @default("#6366f1")
  icon               String?
  hasLecture         Boolean    @default(true)
  hasTutorial        Boolean    @default(false)
  hasPractical       Boolean    @default(false)
  thresholdLecture   Int        @default(75)
  thresholdTutorial  Int        @default(75)
  thresholdPractical Int        @default(75)
  archived           Boolean    @default(false)
  createdAt          DateTime   @default(now())
  slots              Slot[]
  records            AttendanceRecord[]

  @@index([semesterId])
}

// A Slot is a recurring weekly timetable entry (day + time + room),
// OR a one-off extra/rescheduled class when isExtra = true.
model Slot {
  id             String    @id @default(uuid())
  semesterId     String
  semester       Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  type           String    @default("lecture") // "lecture" | "tutorial" | "practical"
  day            Int       // 0 = Monday .. 6 = Sunday
  startTime      String    // "09:00"
  endTime        String    // "10:00"
  room           String?
  prof           String?
  isExtra        Boolean   @default(false) // true = one-off added/rescheduled class
  extraDate      DateTime? // set when isExtra: the specific calendar date it occurs on
  replacesSlotId String?   // set when a reschedule "replaces" the original slot for extraDate
  createdAt      DateTime  @default(now())
  records        AttendanceRecord[]

  @@index([semesterId])
  @@index([subjectId])
}

model AttendanceRecord {
  id         String    @id @default(uuid())
  semesterId String
  semester   Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  slotId     String
  slot       Slot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date       DateTime  // calendar date this record is for
  status     String    // "present" | "absent" | "cancelled" | "rescheduled"
  tag        String?   // for cancelled: "holiday" | "prof_absent" | "exam" | "other"
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([slotId, date]) // one mark per slot per calendar date
  @@index([semesterId])
  @@index([subjectId])
  @@index([date])
}